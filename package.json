{
  "name": "scene-board",
  "version": "1.0.0",
  "private": true,
  "description": "A board for ordering the 115 scenes of The Unseen Sun, with the story data behind it.",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/run.js",
    "check": "npm run build && npm test",
    "serve": "node scripts/serve.js",
    "data": "npm run data:scenes && npm run data:sources && npm run data:boards",
    "data:scenes": "node scripts/make-scenes.js",
    "data:sources": "node scripts/make-sources.js",
    "data:boards": "node scripts/make-boards.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
